{
	"name" : "jon48/webtrees-mod-maj-geodata-france",
	"description" : "MyArtJaub Geographical data Module for webtrees - France",
	"type" : "webtrees-module",
	"keywords" : [
		"webtrees",
		"genealogy",
		"webtrees-module"
	],
	"homepage" : "https://github.com/jon48/webtrees-mod-maj-geodata-france",
	"license" : "GPL-3.0-or-later",
	"authors" : [{
			"name" : "Jonathan Jaubart",
			"email" : "dev@jaubart.com",
			"homepage" : "http://www.jaubart.com",
			"role" : "Developer"
		}
	],
	"support" : {
		"issues" : "https://github.com/jon48/webtrees-mod-maj-geodata-france/issues"
	},
	"config": {
		"platform" : {
			"php" : "7.4"
		},
		"preferred-install": {
            "fisharebest/webtrees": "source"
        },
		"allow-plugins": {
			"composer/package-versions-deprecated": true,
			"bamarni/composer-bin-plugin": true
		}
	},
	"autoload" : {
		"psr-4" : {
			"MyArtJaub\\Webtrees\\Module\\GeoData\\France\\" : "app"
		}
	},
    "autoload-dev": {
        "files" : [
            "vendor/fisharebest/webtrees/tests/TestCase.php"
        ]
    },
	"require" : {
		"jon48/webtrees-lib" : "dev-main-2.1 as dev-main",
		"fisharebest/webtrees" : "~2.1.8",
		"league/flysystem" : "~2.0",
		"league/commonmark": "2.8.2 as 2.8.0"
	},
	"require-dev" : {
		"bamarni/composer-bin-plugin": "^1.8",
		"phpunit/phpunit": "@stable"
	},
	"scripts" : {
		"webtrees-mod-maj-geodata-france:phpcs" : "./vendor-bin/php-cs/vendor/bin/phpcs -s --exclude=Generic.Files.LineEndings",
		"webtrees-mod-maj-geodata-france:phpcbf" : "./vendor-bin/php-cs/vendor/bin/phpcbf --exclude=Generic.Files.LineEndings",
		"webtrees-mod-maj-geodata-france:phpstan" : "./vendor-bin/phpstan/vendor/bin/phpstan analyze --no-progress",
		"webtrees-mod-maj-geodata-france:psalm" : "psalm",
        "webtrees-mod-maj-geodata-france:test": "./vendor/bin/phpunit",
        "webtrees-mod-maj-geodata-france:coverage": "./vendor/bin/phpunit --coverage-clover=tests/coverage.xml --coverage-html=tests/coverage --log-junit=tests/junit.xml"
	},
	"extra" : {
		"installer-name" : "myartjaub_geodata_france",
		"bamarni-bin": {
            "bin-links": false,
			"forward-command": true
        }
	}
}
